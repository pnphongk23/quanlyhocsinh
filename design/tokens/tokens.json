{
  "$comment": "Cùng giá trị với tokens.css. Khóa 'desktop' ghi đè từ 1024px. Sửa cả hai file cùng lúc.",
  "font": {
    "sans": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
  },
  "color": {
    "color-canvas": "#eaecf1",
    "color-bg": "#f6f7f9",
    "color-surface": "#ffffff",
    "color-border": "#e6e9ee",
    "color-divider": "#eef0f3",
    "color-input-border": "#d2d7df",
    "color-input-border-strong": "#b7bec9",
    "color-text": "#14181f",
    "color-muted": "#4a5361",
    "color-placeholder": "#6b7280",
    "color-primary": "#2f5bea",
    "color-primary-ink": "#1e43b8",
    "color-primary-soft": "#e8eefe",
    "color-on-primary": "#ffffff",
    "color-success": "#14663f",
    "color-success-soft": "#e7f6ec",
    "color-warning": "#8a5300",
    "color-warning-soft": "#fff3d6",
    "color-error": "#b42318",
    "color-error-soft": "#fdecec",
    "color-neutral-soft": "#f0f2f5",
    "color-scrim": "rgb(20 24 31 / 0.4)"
  },
  "text": {
    "text-xs": "12px",
    "text-sm": "13px",
    "text-md": "14px",
    "text-base": "16px",
    "text-lg": "18px",
    "text-xl": "22px",
    "text-2xl": "26px",
    "text-3xl": "30px",
    "text-control": "15px"
  },
  "leading": {
    "leading-tight": "1.15",
    "leading-base": "1.5"
  },
  "weight": {
    "weight-regular": "400",
    "weight-semibold": "600",
    "weight-bold": "700"
  },
  "space": {
    "space-2": "2px",
    "space-4": "4px",
    "space-8": "8px",
    "space-12": "12px",
    "space-16": "16px",
    "space-20": "20px",
    "space-24": "24px",
    "space-32": "32px",
    "space-48": "48px"
  },
  "roleSpacing": {
    "page-x": "var(--space-20)",
    "page-top": "var(--space-12)",
    "title-gap": "var(--space-16)",
    "section-gap": "var(--space-24)",
    "card-gap": "var(--space-12)",
    "card-pad": "var(--space-16)",
    "page-gap": "var(--space-12)",
    "page-bottom": "var(--space-16)",
    "row-pad-y": "var(--space-12)",
    "content-max": "1200px",
    "form-max": "640px",
    "guardian-max": "960px"
  },
  "radius": {
    "radius-card": "16px",
    "radius-row": "14px",
    "radius-control": "14px",
    "radius-button": "12px",
    "radius-chip": "10px",
    "radius-sheet": "20px",
    "radius-pill": "999px"
  },
  "shadow": {
    "shadow-sm": "0 1px 2px rgb(20 24 31 / 0.12)",
    "shadow-menu": "0 8px 24px rgb(20 24 31 / 0.14)",
    "shadow-frame": "0 2px 10px rgb(20 24 31 / 0.06)",
    "shadow-fab": "0 6px 16px rgb(35 71 230 / 0.35)",
    "focus-ring": "0 0 0 3px var(--color-primary-soft)"
  },
  "z": {
    "z-raised": "1",
    "z-sticky": "10",
    "z-tabbar": "20",
    "z-fab": "30",
    "z-menu": "40",
    "z-overlay": "100",
    "z-toast": "200"
  },
  "size": {
    "tap": "44px",
    "tap-desktop": "36px",
    "control-h": "52px",
    "button-h-sm": "44px",
    "button-h-md": "48px",
    "button-h-lg": "52px",
    "button-min-w-desktop": "96px",
    "sidebar-width": "248px",
    "tabbar-height": "64px"
  },
  "safeArea": {
    "safe-top": "env(safe-area-inset-top, 0px)",
    "safe-right": "env(safe-area-inset-right, 0px)",
    "safe-bottom": "env(safe-area-inset-bottom, 0px)",
    "safe-left": "env(safe-area-inset-left, 0px)",
    "tabbar-total": "calc(var(--tabbar-height) + var(--safe-bottom))"
  },
  "fab": {
    "fab-size": "56px",
    "fab-inset": "var(--space-16)",
    "fab-right": "max(var(--page-x), var(--safe-right))",
    "fab-bottom": "calc(var(--tabbar-total) + var(--fab-inset))",
    "fab-clearance": "calc(var(--fab-size) + var(--fab-inset) * 2)",
    "fab-pad": "0px"
  },
  "motion": {
    "dur-press": "100ms",
    "dur-fast": "150ms",
    "dur-base": "200ms",
    "dur-slow": "250ms",
    "ease-out": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
    "ease-standard": "cubic-bezier(0.2, 0, 0.2, 1)"
  },
  "state": {
    "state-selected-bg": "var(--color-primary-soft)",
    "state-selected-fg": "var(--color-primary-ink)",
    "state-hover-bg": "var(--color-neutral-soft)",
    "state-pressed-bg": "var(--color-border)",
    "state-focus-ring": "var(--focus-ring)",
    "state-disabled-opacity": "0.5",
    "state-success-bg": "var(--color-success-soft)",
    "state-success-fg": "var(--color-success)",
    "state-error-bg": "var(--color-error-soft)",
    "state-error-fg": "var(--color-error)",
    "state-pending-bg": "var(--color-warning-soft)",
    "state-pending-fg": "var(--color-warning)",
    "dur-loading-min": "400ms",
    "dur-success-hold": "1600ms",
    "empty-mascot": "96px",
    "empty-mascot-compact": "56px"
  },
  "grid": {
    "grid-col-name-min": "140px",
    "grid-col-name-max": "280px",
    "grid-col-test-max": "240px",
    "grid-cell-input-min": "140px",
    "grid-resize-step": "8px"
  },
  "breakpoint": {
    "desktop": 1024,
    "unit": "px",
    "note": "mobile < 1024, desktop >= 1024; CSS var không dùng được trong @media"
  },
  "desktop": {
    "page-x": "var(--space-32)",
    "page-top": "28px",
    "page-bottom": "28px",
    "page-gap": "var(--space-20)",
    "title-gap": "var(--space-24)",
    "section-gap": "var(--space-32)",
    "card-gap": "var(--space-16)",
    "card-pad": "var(--space-20)",
    "tabbar-total": "0px",
    "fab-right": "var(--space-24)",
    "fab-bottom": "var(--space-24)"
  },
  "reducedMotion": "--dur-press/fast/base/slow = 1ms khi prefers-reduced-motion: reduce"
}
