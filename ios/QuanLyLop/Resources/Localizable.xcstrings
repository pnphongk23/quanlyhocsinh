{
  "sourceLanguage": "vi",
  "strings": {
    "app.name": {
      "comment": "Tên app hiển thị trong app. Tên tạm, đổi cùng lúc với CFBundleDisplayName.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý lớp"
          }
        }
      }
    },
    "core.apiError.accountDisabled": {
      "comment": "Tài khoản/membership bị vô hiệu.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản hoặc vai trò đã bị vô hiệu hóa."
          }
        }
      }
    },
    "core.apiError.accountNotResettable": {
      "comment": "409 account_not_resettable.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cấp lại mật khẩu cho tài khoản này."
          }
        }
      }
    },
    "core.apiError.conflict": {
      "comment": "409 conflict/version_conflict từ API trực tuyến (ví dụ PATCH lớp); không phải xung đột ô đồng bộ.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu đã thay đổi ở nơi khác. Vui lòng mở lại màn hình."
          }
        }
      }
    },
    "core.apiError.forbidden": {
      "comment": "403 thiếu quyền.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không có quyền thực hiện thao tác này."
          }
        }
      }
    },
    "core.apiError.invalidCredentials": {
      "comment": "Sai SĐT/mật khẩu.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số điện thoại hoặc mật khẩu không đúng."
          }
        }
      }
    },
    "core.apiError.notFound": {
      "comment": "404, gồm membership đã bị gỡ.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy dữ liệu hoặc bạn không còn quyền truy cập."
          }
        }
      }
    },
    "core.apiError.passwordChangeRequired": {
      "comment": "403 bắt buộc đổi mật khẩu.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng đổi mật khẩu trước khi tiếp tục."
          }
        }
      }
    },
    "core.apiError.payloadTooLarge": {
      "comment": "413 payload quá lớn.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu gửi lên quá lớn."
          }
        }
      }
    },
    "core.apiError.rateLimited": {
      "comment": "429 quá nhiều lần gọi.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thao tác quá nhanh. Vui lòng thử lại sau."
          }
        }
      }
    },
    "core.apiError.rejected": {
      "comment": "Lệnh bị từ chối khi đồng bộ nhưng response thiếu mã lỗi; giữ lệnh, hiện lỗi cho người dùng.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được thay đổi này. Vui lòng kiểm tra lại."
          }
        }
      }
    },
    "core.apiError.resyncRequired": {
      "comment": "409 resync_required/snapshot_required.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần tải lại dữ liệu."
          }
        }
      }
    },
    "core.apiError.unauthorized": {
      "comment": "401: phiên hết hạn hoặc đã thu hồi.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại."
          }
        }
      }
    },
    "core.apiError.unknown": {
      "comment": "Lỗi khác chưa có thông điệp riêng.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối dịch vụ. Vui lòng thử lại."
          }
        }
      }
    },
    "core.apiError.validationError": {
      "comment": "422/400 dữ liệu sai.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu chưa hợp lệ. Vui lòng kiểm tra lại."
          }
        }
      }
    },
    "core.stars.one": {
      "comment": "Mẫu nhận xét 1 sao chèn sẵn vào ô nhận xét.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con chỉ đạt 1 sao 🌟. Chưa tập trung, nói chuyện làm việc riêng. Đã ghi chép bài đầy đủ."
          }
        }
      }
    },
    "core.stars.three": {
      "comment": "Mẫu nhận xét 3 sao chèn sẵn vào ô nhận xét.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con hoàn thành 3 sao 🌟🌟🌟. Tập trung, tích cực học tập. Ghi bài đầy đủ, hiểu bài!"
          }
        }
      }
    },
    "core.stars.two": {
      "comment": "Mẫu nhận xét 2 sao chèn sẵn vào ô nhận xét.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con hoàn thành 2 sao 🌟🌟. Ghi bài đầy đủ, tham gia hoạt động học tập. Còn mất trật tự."
          }
        }
      }
    },
    "design.action.close": {
      "comment": "Nút đóng của sheet (.dialogHeader).",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng"
          }
        }
      }
    },
    "design.action.retry": {
      "comment": "Nút thử lại trong khung lỗi.",
