    "core.stars.one": {
      "comment": "Mẫu nhận xét 1 sao chèn sẵn vào ô nhận xét.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con chỉ đạt 1 sao 🌟. Chưa tập trung, nói chuyện làm việc riêng. Đã ghi chép bài đầy đủ."
          }
        }
      }
    },
    "core.stars.three": {
      "comment": "Mẫu nhận xét 3 sao chèn sẵn vào ô nhận xét.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con hoàn thành 3 sao 🌟🌟🌟. Tập trung, tích cực học tập. Ghi bài đầy đủ, hiểu bài!"
          }
        }
      }
    },
    "core.stars.two": {
      "comment": "Mẫu nhận xét 2 sao chèn sẵn vào ô nhận xét.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
