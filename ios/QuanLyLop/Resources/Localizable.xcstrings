        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thao tác quá nhanh. Vui lòng thử lại sau."
          }
        }
      }
    },
    "core.apiError.rejected": {
      "comment": "Lệnh bị từ chối khi đồng bộ nhưng response thiếu mã lỗi; giữ lệnh, hiện lỗi cho người dùng.",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được thay đổi này. Vui lòng kiểm tra lại."
          }
        }
      }
    },
    "core.apiError.resyncRequired": {
