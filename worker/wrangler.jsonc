{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qlh-staging-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": false
  },
  "vars": {
    "ENVIRONMENT": "local",
    "PBKDF2_ITERATIONS": "100000",
    // CORS cho /v1/*: danh sách origin (phân tách dấu phẩy), rỗng = không cho origin nào.
    "ALLOWED_ORIGINS": ""
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qlh-staging-db",
      "database_id": "REPLACE_AT_DEPLOY",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "qlh-staging-api",
      "vars": {
        "ENVIRONMENT": "staging",
        "PBKDF2_ITERATIONS": "100000",
        // Điền origin Cloudflare Pages của staging (và localhost) trước khi dùng web,
        // ví dụ "https://qlh-staging.pages.dev,http://localhost:5173". Rỗng = chặn mọi
        // origin khác miền (iOS không bị ảnh hưởng).
        "ALLOWED_ORIGINS": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qlh-staging-db",
          "database_id": "ab89f59d-5f7e-4db2-aff0-cbb2932d0a6d",
          "migrations_dir": "migrations"
        }
      ],
      // R2 is not enabled for this account yet. To enable report PDFs:
      // 1. Create the qlh-staging-reports bucket in Cloudflare.
      // 2. Uncomment this binding, then deploy the staging environment.
      // "r2_buckets": [
      //   { "binding": "REPORT_PDFS", "bucket_name": "qlh-staging-reports" }
      // ]
    }
  }
}
